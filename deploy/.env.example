# ==============================================================================
# deploy 环境变量示例
# 复制为 .env 后使用：cp .env.example .env
# .env 已在 .gitignore 中忽略，切勿提交真实密码
# ==============================================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root123456

# 启动时自动创建的数据库名（需与后端数据源配置一致）
MYSQL_DATABASE=se2026

# 应用专用账号（后端用它连库，避免用 root；需与 backend/.env 的 DATABASE_URL 一致）
MYSQL_USER=se2026
MYSQL_PASSWORD=se2026_pwd

# 宿主机映射端口（若本机已装 MySQL 占用 3306，改成 3307 等）
MYSQL_PORT=3306

# Redis 宿主机映射端口
REDIS_PORT=6379
