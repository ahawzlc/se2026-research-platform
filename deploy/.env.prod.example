# ==============================================================================
# 生产环境变量示例
#   cp .env.prod.example .env.prod && vi .env.prod
# .env.prod 已在 .gitignore 中忽略，**切勿提交真实密码**
# ==============================================================================

# ---------- 数据库 ----------
# root 密码：仅用于容器内运维，不对外暴露端口
MYSQL_ROOT_PASSWORD=请替换为随机强密码
MYSQL_DATABASE=se2026
# 应用账号（后端用它连库，避免用 root）
MYSQL_USER=se2026
MYSQL_PASSWORD=请替换为随机强密码

# ---------- 后端 ----------
# 用 openssl rand -base64 48 生成；改动后已签发的令牌全部失效
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRES_IN_SECONDS=604800
# 演示/联调期 true；正式对外请改 false，否则任何人可签发任意用户令牌
APP_ENABLE_DEV_TOKEN=true
# 前端经 Nginx 同源访问，一般不触发 CORS；保留 * 便于直连调试
CORS_ORIGIN=*

# ---------- 网关 ----------
# 宿主机对外端口（腾讯云安全组需同步放行）
WEB_PORT=80
