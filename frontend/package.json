{
  "name": "se2026-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校园科研项目协作与成果管理平台 —— 前端",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
