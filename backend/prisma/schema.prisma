// ==============================================================================
// 校园科研项目协作与成果管理平台 —— Prisma 数据模型
// ------------------------------------------------------------------------------
// 口径来源：deploy/mysql/init/01-schema.sql 与 docs/02-数据字典.md
// 表数量：24（账号 3 + 支撑 1 + 业务 10 + 沟通 3 + 统计 1 + 社区与通知 6）
//
// 【重要约定，组内必读】
//   1. 建表以 deploy/mysql/init/01-schema.sql 为准；本文件只做映射，不改结构。
//   2. 禁止执行 `prisma migrate dev` 与 `prisma db push`：它们会按本模型重建/改动
//      表结构，与既有 DDL 冲突。
//   3. 数据库层外键自 2026-11-03 起与 init SQL 严格对齐（约束名 `<表>_<列>_fkey`，
//      ON DELETE RESTRICT / 可空列 SET NULL / ON UPDATE CASCADE，口径见 docs/02）；
//      多态引用列（conversation / message / activity_log / notification 的
//      ref_type + ref_id）不建外键，指向哪张表由应用层 ref_type 决定。
//      → 仍【不要】用 `prisma db pull` 覆盖本文件：反向生成不带自定义关系名。
//   4. 字段命名：TypeScript 侧用 camelCase，数据库侧用 snake_case（@map / @@map）。
//   5. 所有表都有 `deleted` 逻辑删除标记（0 正常 / 1 已删除），
//      业务查询必须显式带 `deleted: 0`——Prisma 不会自动过滤。
//   6. activity_log 只增不改：无 updated_at、无 deleted。
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 一、账号类
// ==============================================================================

/// 用户
model User {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  username     String   @unique(map: "uk_user_username") @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  nickname     String   @default("") @db.VarChar(50)
  avatar       String   @default("") @db.VarChar(255)
  email        String   @default("") @db.VarChar(100)
  /// 对外展示的 UID，创建后不可变；NULL 表示尚未分配（存量用户由迁移脚本回填）
  publicUid    String?  @unique(map: "uk_user_public_uid") @map("public_uid") @db.VarChar(20)
  /// 个人简介
  bio          String   @default("") @db.VarChar(500)
  /// 主页可见范围：public / friends / private
  profileVisibility String @default("public") @map("profile_visibility") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted      Int      @default(0) @db.UnsignedTinyInt

  ownedTeams        Team[]              @relation("TeamOwner")
  teamMemberships   TeamMember[]
  projectMemberships ProjectMember[]
  assignedTasks     Task[]              @relation("TaskAssignee")
  uploadedFiles     File[]              @relation("FileUploader")
  uploadedLiterature Literature[]       @relation("LiteratureUploader")
  meetingAttendances MeetingAttendee[]
  achievementMembers AchievementMember[]
  conversationMembers ConversationMember[]
  sentMessages      Message[]           @relation("MessageSender")
  activityLogs      ActivityLog[]
  communityPosts    CommunityPost[]     @relation("CommunityPostAuthor")
  teamApplications  TeamApplication[]   @relation("TeamApplicant")
  handledApplications TeamApplication[] @relation("ApplicationHandler")
  friendshipRequested Friendship[]      @relation("FriendshipRequester")
  friendshipReceived  Friendship[]      @relation("FriendshipAddressee")
  notifications     Notification[]

  @@index([email], map: "idx_user_email")
  @@map("user")
}

/// 课题组
model Team {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(500)
  inviteCode  String   @unique(map: "uk_team_invite_code") @map("invite_code") @db.VarChar(16)
  ownerId     BigInt   @map("owner_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted     Int      @default(0) @db.UnsignedTinyInt

  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  projects    Project[]
  literature  Literature[]
  activityLogs ActivityLog[]
  communityPosts CommunityPost[]

  @@index([ownerId], map: "idx_team_owner")
  @@map("team")
}

/// 课题组成员；role: owner / admin / member
model TeamMember {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  teamId    BigInt   @map("team_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  role      String   @default("member") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId], map: "uk_team_member")
  @@index([userId], map: "idx_team_member_user")
  @@map("team_member")
}

// ==============================================================================
// 二、支撑类（补充表：literature / achievement 的 file_id 需要有落点）
// ==============================================================================

/// 上传文件
model File {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uploaderId   BigInt   @map("uploader_id") @db.UnsignedBigInt
  originalName String   @map("original_name") @db.VarChar(255)
  storedPath   String   @map("stored_path") @db.VarChar(500)
  url          String?  @db.VarChar(500)
  size         BigInt   @default(0) @db.UnsignedBigInt
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deleted      Int      @default(0) @db.UnsignedTinyInt

  uploader    User          @relation("FileUploader", fields: [uploaderId], references: [id])
  literature  Literature[]
  achievements Achievement[]

  @@index([uploaderId], map: "idx_file_uploader")
  @@map("file")
}

// ==============================================================================
// 三、业务类
// ==============================================================================

/// 项目；status: planning / active / finished / archived
model Project {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  teamId      BigInt    @map("team_id") @db.UnsignedBigInt
  name        String    @db.VarChar(100)
  description String    @default("") @db.VarChar(500)
  status      String    @default("planning") @db.VarChar(20)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted     Int       @default(0) @db.UnsignedTinyInt

  team         Team              @relation(fields: [teamId], references: [id])
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  literature   Literature[]
  meetings     Meeting[]
  achievements Achievement[]

  @@index([teamId], map: "idx_project_team")
  @@map("project")
}

/// 项目成员
model ProjectMember {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  projectId BigInt   @map("project_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId], map: "uk_project_member")
  @@map("project_member")
}

/// 里程碑；status: pending / done
model Milestone {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId BigInt    @map("project_id") @db.UnsignedBigInt
  name      String    @db.VarChar(100)
  dueDate   DateTime? @map("due_date") @db.Date
  status    String    @default("pending") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int       @default(0) @db.UnsignedTinyInt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId], map: "idx_milestone_project")
  @@map("milestone")
}

/// 任务（看板）；status: todo / doing / done，priority: low / medium / high
model Task {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId   BigInt    @map("project_id") @db.UnsignedBigInt
  title       String    @db.VarChar(200)
  description String?   @db.Text
  assigneeId  BigInt?   @map("assignee_id") @db.UnsignedBigInt
  status      String    @default("todo") @db.VarChar(20)
  priority    String    @default("medium") @db.VarChar(10)
  dueDate     DateTime? @map("due_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted     Int       @default(0) @db.UnsignedTinyInt

  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId, status, sortOrder], map: "idx_task_project_status")
  @@index([assigneeId], map: "idx_task_assignee")
  @@map("task")
}

/// 文献；read_status: unread / reading / read
model Literature {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  teamId     BigInt   @map("team_id") @db.UnsignedBigInt
  projectId  BigInt?  @map("project_id") @db.UnsignedBigInt
  title      String   @db.VarChar(300)
  sourceUrl  String?  @map("source_url") @db.VarChar(500)
  fileId     BigInt?  @map("file_id") @db.UnsignedBigInt
  readStatus String   @default("unread") @map("read_status") @db.VarChar(20)
  uploaderId BigInt   @map("uploader_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted    Int      @default(0) @db.UnsignedTinyInt

  team     Team            @relation(fields: [teamId], references: [id])
  project  Project?        @relation(fields: [projectId], references: [id])
  file     File?           @relation(fields: [fileId], references: [id])
  uploader User            @relation("LiteratureUploader", fields: [uploaderId], references: [id])
  tags     LiteratureTag[]

  @@index([teamId], map: "idx_literature_team")
  @@index([uploaderId], map: "idx_literature_uploader")
  @@map("literature")
}

/// 文献标签（无 updated_at）
model LiteratureTag {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  literatureId BigInt   @map("literature_id") @db.UnsignedBigInt
  tag          String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deleted      Int      @default(0) @db.UnsignedTinyInt

  literature Literature @relation(fields: [literatureId], references: [id])

  @@unique([literatureId, tag], map: "uk_literature_tag")
  @@map("literature_tag")
}

/// 会议记录
model Meeting {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  projectId BigInt    @map("project_id") @db.UnsignedBigInt
  title     String    @db.VarChar(200)
  heldAt    DateTime? @map("held_at") @db.DateTime(0)
  location  String?   @db.VarChar(200)
  content   String?   @db.LongText
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int       @default(0) @db.UnsignedTinyInt

  project   Project           @relation(fields: [projectId], references: [id])
  attendees MeetingAttendee[]

  @@index([projectId, heldAt], map: "idx_meeting_project")
  @@map("meeting")
}

/// 参会人（无 updated_at）
model MeetingAttendee {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  meetingId BigInt   @map("meeting_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId], map: "uk_meeting_attendee")
  @@map("meeting_attendee")
}

/// 成果；type: paper / patent / software / award / other
model Achievement {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  projectId   BigInt   @map("project_id") @db.UnsignedBigInt
  type        String   @db.VarChar(30)
  title       String   @db.VarChar(300)
  description String?  @db.Text
  fileId      BigInt?  @map("file_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted     Int      @default(0) @db.UnsignedTinyInt

  project Project             @relation(fields: [projectId], references: [id])
  file    File?               @relation(fields: [fileId], references: [id])
  members AchievementMember[]

  @@index([projectId], map: "idx_achievement_project")
  @@map("achievement")
}

/// 成果成员关联；contribution_note 仅展示用，不参与任何计算
model AchievementMember {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  achievementId    BigInt   @map("achievement_id") @db.UnsignedBigInt
  userId           BigInt   @map("user_id") @db.UnsignedBigInt
  contributionNote String?  @map("contribution_note") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted          Int      @default(0) @db.UnsignedTinyInt

  achievement Achievement @relation(fields: [achievementId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([achievementId, userId], map: "uk_achievement_member")
  @@map("achievement_member")
}

// ==============================================================================
// 四、沟通类（统一会话模型：评论 / 讨论区 / 私信共用）
// ==============================================================================

/// 会话；type: comment（上下文评论）/ group（项目讨论区）/ private（私信，不计入统计）/ meeting（会议讨论区，ref 指向 meeting，F-1）
model Conversation {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  type      String   @db.VarChar(20)
  refType   String?  @map("ref_type") @db.VarChar(30)
  refId     BigInt?  @map("ref_id") @db.UnsignedBigInt
  title     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  members  ConversationMember[]
  messages Message[]

  @@index([refType, refId], map: "idx_conversation_ref")
  @@map("conversation")
}

/// 会话成员与已读位点；last_read_at 是未读数计算的唯一依据
model ConversationMember {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId BigInt    @map("conversation_id") @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  lastReadAt     DateTime? @map("last_read_at") @db.DateTime(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted        Int       @default(0) @db.UnsignedTinyInt

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId], map: "uk_conversation_member")
  @@index([userId], map: "idx_cm_user")
  @@map("conversation_member")
}

/// 消息（无 updated_at）；msg_type: text / file / system
model Message {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId BigInt   @map("conversation_id") @db.UnsignedBigInt
  senderId       BigInt   @map("sender_id") @db.UnsignedBigInt
  content        String?  @db.Text
  msgType        String   @default("text") @map("msg_type") @db.VarChar(20)
  refType        String?  @map("ref_type") @db.VarChar(30)
  refId          BigInt?  @map("ref_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deleted        Int      @default(0) @db.UnsignedTinyInt

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, id], map: "idx_message_conversation")
  @@map("message")
}

// ==============================================================================
// 五、统计类（贡献度分析的唯一数据来源，只增不改）
// ==============================================================================

/// 行为埋点流水；type 取值见 docs/03-贡献度口径说明.md
/// 注意：本表没有 updated_at 与 deleted，写入后不得修改或删除
model ActivityLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  teamId    BigInt   @map("team_id") @db.UnsignedBigInt
  type      String   @db.VarChar(40)
  refType   String?  @map("ref_type") @db.VarChar(30)
  refId     BigInt?  @map("ref_id") @db.UnsignedBigInt
  weight    Decimal  @default(1.00) @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId, userId, createdAt], map: "idx_log_team_user_time")
  @@index([teamId, type], map: "idx_log_team_type")
  @@index([userId, createdAt], map: "idx_log_user_time")
  @@index([type, refType, refId], map: "idx_log_ref")
  @@map("activity_log")
}

// ==============================================================================
// 六、社区与通知类（2026-11-20，卡 G-0；存量库用 migrations/20261120-01 增量升级）
// ==============================================================================

/// 组队广场标签字典；category: competition 竞赛 / course 课程；种子清单见 init SQL 与 migration（两处同步维护）
model CommunityTag {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(50)
  category  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  posts CommunityPostTag[]

  @@unique([name, category], map: "uk_community_tag")
  @@map("community_tag")
}

/// 组队招募帖；status: recruiting 招募中 / full 已满员 / closed 已停止；平台第一个跨组公开内容
model CommunityPost {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  title          String   @db.VarChar(50)
  content        String?  @db.Text
  recruitTotal   Int      @default(1) @map("recruit_total") @db.UnsignedTinyInt
  recruitedCount Int      @default(0) @map("recruited_count") @db.UnsignedTinyInt
  status         String   @default("recruiting") @db.VarChar(20)
  teamId         BigInt?  @map("team_id") @db.UnsignedBigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted        Int      @default(0) @db.UnsignedTinyInt

  author       User                @relation("CommunityPostAuthor", fields: [userId], references: [id])
  team         Team?               @relation(fields: [teamId], references: [id])
  tags         CommunityPostTag[]
  applications TeamApplication[]

  @@index([userId], map: "idx_community_post_user")
  @@index([status, id], map: "idx_community_post_status")
  @@index([teamId], map: "community_post_team_id_fkey")
  @@map("community_post")
}

/// 帖子-标签关联（照 literature_tag 模式：无 updated_at）
model CommunityPostTag {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  postId    BigInt   @map("post_id") @db.UnsignedBigInt
  tagId     BigInt   @map("tag_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  post CommunityPost @relation(fields: [postId], references: [id])
  tag  CommunityTag  @relation(fields: [tagId], references: [id])

  @@unique([postId, tagId], map: "uk_community_post_tag")
  @@map("community_post_tag")
}

/// 组队申请；status: pending / approved / rejected（不可逆）；被拒后不可再申请同帖（唯一键 + 状态校验双保险）
model TeamApplication {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  postId    BigInt    @map("post_id") @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  note      String    @default("") @db.VarChar(200)
  status    String    @default("pending") @db.VarChar(20)
  handledBy BigInt?   @map("handled_by") @db.UnsignedBigInt
  handledAt DateTime? @map("handled_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int       @default(0) @db.UnsignedTinyInt

  post      CommunityPost @relation(fields: [postId], references: [id])
  applicant User          @relation("TeamApplicant", fields: [userId], references: [id])
  handler   User?         @relation("ApplicationHandler", fields: [handledBy], references: [id])

  @@unique([postId, userId], map: "uk_team_application")
  @@index([userId], map: "idx_team_application_user")
  @@index([handledBy], map: "team_application_handled_by_fkey")
  @@map("team_application")
}

/// 好友关系（单向行表示一条关系）；status: pending / accepted / rejected（被拒可再次发起：复用本行改回 pending，受唯一键约束）
model Friendship {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  requesterId  BigInt    @map("requester_id") @db.UnsignedBigInt
  addresseeId  BigInt    @map("addressee_id") @db.UnsignedBigInt
  status       String    @default("pending") @db.VarChar(20)
  handledAt    DateTime? @map("handled_at") @db.DateTime(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted      Int       @default(0) @db.UnsignedTinyInt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId], map: "uk_friendship")
  @@index([addresseeId], map: "idx_friendship_addressee")
  @@map("friendship")
}

/// 站内通知；type: team_apply / team_apply_approved / team_apply_rejected / friend_request / friend_accepted / meeting_upcoming（F-2 占位）；唯一写入口是 G-1 的 NotificationService.push
model Notification {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  type      String   @db.VarChar(30)
  title     String   @db.VarChar(200)
  refType   String?  @map("ref_type") @db.VarChar(30)
  refId     BigInt?  @map("ref_id") @db.UnsignedBigInt
  isRead    Int      @default(0) @map("is_read") @db.UnsignedTinyInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deleted   Int      @default(0) @db.UnsignedTinyInt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead], map: "idx_notification_user_read")
  @@index([userId, type, refId], map: "idx_notification_dedupe")
  @@map("notification")
}
