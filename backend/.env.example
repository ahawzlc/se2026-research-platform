# ==============================================================================
# 后端环境变量样例 —— 复制为 .env 后按需修改
#   cp .env.example .env        （Windows PowerShell: Copy-Item .env.example .env）
# .env 已在 .gitignore 中忽略，**不要提交真实密钥**
# ==============================================================================

# ---------- 应用 ----------
# 后端固定端口 8080（前端 vite proxy /api → localhost:8080，变更需全组同步）
APP_PORT=8080
# development / production
NODE_ENV=development
# 开发令牌接口开关：仅用于本地联调自测，生产必须设为 false
APP_ENABLE_DEV_TOKEN=true
# 允许的跨域来源，开发期用 * 即可
CORS_ORIGIN=*

# ---------- 数据库（Prisma 使用单一 DATABASE_URL）----------
# 对应 deploy/docker-compose.yml 中的 mysql 服务
# 本机开发：主机名用 127.0.0.1（Windows 下 localhost 可能被解析为 IPv6 ::1，Prisma 连不上）
# 容器内运行（compose 的 backend 服务）：主机名改用 mysql（服务名）
DATABASE_URL="mysql://se2026:se2026_pwd@127.0.0.1:3306/se2026"

# ---------- JWT ----------
# 生产环境务必替换为随机长字符串（例如 openssl rand -base64 48）
JWT_SECRET=change-me-in-production
# 令牌有效期（秒），默认 7 天
JWT_EXPIRES_IN_SECONDS=604800

# ---------- 文件上传 ----------
# 本地磁盘存储根目录（相对 backend/ 或绝对路径）
UPLOAD_DIR=./uploads
# 对外访问前缀，最终 URL 形如 /api/v1/files/<storedPath>
UPLOAD_URL_PREFIX=/api/v1/files

# ---------- 可选：Redis ----------
# 不配置则不启用缓存
REDIS_URL=redis://localhost:6379
