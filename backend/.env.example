# ==============================================================================
# backend 环境变量示例
# 复制为 backend/.env 后按需修改；.env 不入库
#
# 键名为语言无关的约定，Spring Boot 与 NestJS 都按此命名映射
# （Spring Boot 可在 application.yml 中用 ${MYSQL_HOST:localhost} 引用）
# ==============================================================================

# ---------- 服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库（与 deploy/.env 保持一致）----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=se2026
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123456

# ---------- Redis（可选，启用缓存时填写）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 认证 ----------
# JWT 签名密钥，务必替换为随机长字符串，严禁使用示例值上线
JWT_SECRET=change-me-to-a-random-long-secret
JWT_EXPIRE_MINUTES=1440

# ---------- 文件上传 ----------
# 存储方式：local / minio / oss
UPLOAD_STORAGE=local
UPLOAD_LOCAL_PATH=./uploads
UPLOAD_MAX_SIZE_MB=50
# 允许的扩展名白名单，逗号分隔
UPLOAD_ALLOWED_EXT=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,md,zip,png,jpg,jpeg

# ---------- 日志 ----------
LOG_LEVEL=info
