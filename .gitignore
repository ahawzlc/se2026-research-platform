# ============================================================
# 校园科研项目协作与成果管理平台 —— 全局忽略规则
# 说明：各子工程（frontend/ backend/）另有自己的 .gitignore，
#       本文件负责跨模块的通用忽略项。
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
build/
out/
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
!mvn/wrapper/maven-wrapper.jar
*.tsbuildinfo

# ---------- 环境变量（严禁入库）----------
# 只提交 *.example，真实的 .env / .env.prod 一律不入库
.env
.env.*
!.env.example
!.env.prod.example

# ---------- 日志与临时文件 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.history/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 运行时数据（容器卷 / 上传文件）----------
# 这些是本地运行产生的内容，不入库；目录结构用 .gitkeep 保留
deploy/data/
uploads/
data/
!uploads/.gitkeep

# ---------- 覆盖率与缓存 ----------
coverage/
.cache/
.eslintcache
.prettiercache

# ---------- 本地工具 / 中间产物 ----------
.workbuddy/
output/
